    "import cv2\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "\n",
    "path = 'imagen2.jpg' \n",
    "img = cv2.imread(path, cv2.IMREAD_GRAYSCALE)\n",
    "\n",
    "\n",
    "if img is None:\n",
    "    print(f\"Error: No se pudo encontrar la imagen en {path}\")\n",
    "else:\n",
    "\n",
    "    laplaciano = cv2.Laplacian(img, cv2.CV_64F, ksize=3)\n",
    "    \n",
    "    \n",
    "    laplaciano_abs = np.uint8(np.absolute(laplaciano))\n",
    "\n",
    "\n",
    "    suavizado = cv2.GaussianBlur(img, (5, 5), 0)\n",
    "    \n",
    "  \n",
    "    log = cv2.Laplacian(suavizado, cv2.CV_64F, ksize=5)\n",
    "    \n",
    "    \n",
    "    log_abs = np.uint8(np.absolute(log))\n",
    "\n",
    "    \n",
    "    plt.figure(figsize=(15, 5))\n",
    "\n",
    "    \n",
    "    plt.subplot(1, 3, 1)\n",
    "    plt.imshow(img, cmap='gray')\n",
    "    plt.title('1. Imagen Original')\n",
    "    plt.axis('off')\n",
    "\n",
    "   \n",
    "    plt.subplot(1, 3, 2)\n",
    "    plt.imshow(laplaciano_abs, cmap='gray')\n",
    "    plt.title('2. Laplaciano (Sensible al ruido)')\n",
    "    plt.axis('off')\n",
    "\n",
    "  \n",
    "    plt.subplot(1, 3, 3)\n",
    "    plt.imshow(log_abs, cmap='gray')\n",
    "    plt.title('3. LoG (Suavizado + Laplaciano)')\n",
    "    plt.axis('off')\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  }
